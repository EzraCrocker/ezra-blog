---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Ezra Crocker</h1>

			<p>
				<strong>Network Engineering Portfolio & Blog</strong>
			</p>

			<p>
				I’m an IT professional focused on network engineering, infrastructure troubleshooting,
				and technical documentation. This site is where I document networking concepts,
				real-world troubleshooting, lab work, and projects as I continue growing deeper into
				network engineering and infrastructure.
			</p>

			<p>
				My main focus is networking, including routing, switching, wireless, DNS, DHCP,
				VLANs, firewalls, and troubleshooting methodology. I also use this site to document
				my curiosity across related areas of technology, including cloud, automation,
				security, Linux, and modern infrastructure tools.
			</p>

			<h2>Start Here</h2>

			<ul>
				<li>
					<a href="/resume">View my resume</a>
				</li>
				<li>
					<a href="/projects">View my technical projects</a>
				</li>
				<li>
					<a href="/notes">Read my technical notes</a>
				</li>
			</ul>

			<h2>Featured Areas</h2>

			<ul>
				<li>Network engineering fundamentals, routing, switching, DNS, DHCP, VLANs, and wireless</li>
				<li>Infrastructure troubleshooting, root cause analysis, and technical documentation</li>
				<li>Firewalls, segmentation, secure connectivity, and network services</li>
				<li>Cloud networking, automation, Linux, GitHub, and modern infrastructure tools</li>
			</ul>
		</main>
		<Footer />
	</body>
