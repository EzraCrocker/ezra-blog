---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Resume | Ezra Crocker" description="Resume for Ezra Crocker" />
	</head>
	<body>
		<Header />

		<main>
			<h1>Resume</h1>

			<p>
				This page contains my current resume. You can view it directly below, open it in a
				new tab, or download a copy.
			</p>

			<p>
				<a href="/resume/Ezra_Crocker_Network_Engineering_Resume.pdf" target="_blank">
					Open PDF Resume
				</a>
				|
				<a href="/resume/Ezra_Crocker_Network_Engineering_Resume.pdf" download>
					Download PDF
				</a>
				|
				<a href="/resume/Ezra_Crocker_Network_Engineering_Resume.pdf" download>
					Download Word Document
				</a>
			</p>

			<iframe
				src="/resume/Ezra_Crocker_Network_Engineering_Resume.pdf"
				width="100%"
				height="900px"
				title="Ezra Crocker Resume"
			>
			</iframe>
		</main>

		<Footer />
	</body>
</html>